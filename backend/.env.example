DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/k8s_survival
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mission system
# CHAOS_BACKEND: mock | chaos_mesh
CHAOS_BACKEND=mock
# VALIDATION_BACKEND: mock | k8s | prometheus
VALIDATION_BACKEND=mock
MOCK_VALIDATION_AUTO_PASS=false
PROMETHEUS_URL=http://localhost:9090

# AI
# AI_BACKEND: mock | openai | gemini
AI_BACKEND=mock

# OpenAI (AI_BACKEND=openai 일 때 사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCENARIO_MODEL=gpt-4o-mini
TUTOR_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Gemini (AI_BACKEND=gemini 일 때 사용, Google AI Studio에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Qdrant (RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
KNOWLEDGE_BASE_DIR=../ai-data/knowledge-base
