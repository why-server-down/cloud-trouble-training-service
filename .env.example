# Docker Compose defaults work without this file.
# Copy this file to .env only when overriding local settings.

SECRET_KEY=local-dev-secret-key
AI_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
OPENAI_TIMEOUT=10
CONTEXT_COLLECTION_TIMEOUT=3
RAG_SEARCH_TIMEOUT=2
AI_MAX_CONTEXT_TOKENS=9000
AI_MAX_COMPLETION_TOKENS=500
AI_MAX_RETRIEVED_CHUNKS=5
AI_PROVIDER_MAX_ATTEMPTS=2
CHAOS_BACKEND=mock
VALIDATION_BACKEND=prometheus
MOCK_VALIDATION_AUTO_PASS=false
DEMO_UNLOCK_AI_SCENARIOS=false

# Browser-facing URLs embedded into the Vite production build.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_GRAFANA_BASE_URL=http://localhost:3001

# Optional monitoring profile.
GF_SECURITY_ADMIN_PASSWORD=admin

# ── 운영 설정 (BE-23) ─────────────────────────────────────────────────────
# 허용 origin 목록(쉼표 구분). 배포에서는 반드시 지정한다.
# wildcard 와 자격 증명을 함께 쓰면 브라우저가 아무 origin 에나 쿠키를 보낸다.
# localhost 와 127.0.0.1 은 브라우저가 서로 다른 origin 으로 본다. 둘 다 넣는다.
# LAN IP 로 시연할 때는 그 origin 을 여기에 추가해야 한다(vite host:true).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# chat 은 호출마다 LLM 비용이 나간다. 사용자당 분당 허용 횟수.
CHAT_RATE_LIMIT_PER_MINUTE=12

# 유휴 세션 정리 기준(초)
SESSION_IDLE_TTL_SECONDS=3600

# ── 보존 정책 (BE-29) ─────────────────────────────────────────────────────
# 튜터 대화 보존 기간(일). 0 이하면 정리하지 않는다.
# 진행 중인 attempt 의 대화는 기간이 지나도 지우지 않는다.
TUTOR_MESSAGE_RETENTION_DAYS=30
# 한 번에 지우는 행 수. 한 트랜잭션이 테이블을 오래 잡지 않게 나눠 지운다.
RETENTION_DELETE_BATCH=1000

# competency 의 speed 항이 기준으로 삼는 목표 복구 시간(초)
TARGET_MTTR_SECONDS=900

# RuntimeContext 수집 timeout(초). 부분 실패를 허용한다.
RUNTIME_CONTEXT_TIMEOUT_SECONDS=3
