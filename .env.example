# Docker Compose defaults work without this file.
# Copy this file to .env only when overriding local settings.

SECRET_KEY=local-dev-secret-key
AI_BACKEND=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHAOS_BACKEND=mock
VALIDATION_BACKEND=mock
MOCK_VALIDATION_AUTO_PASS=false

# Browser-facing URLs embedded into the Vite production build.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Optional monitoring profile.
GF_SECURITY_ADMIN_PASSWORD=admin
