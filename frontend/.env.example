# API 서버 URL
# 로컬 Docker/Nginx 또는 Vite dev proxy 환경에서는 비워두면 같은 origin의 /api 프록시를 사용합니다.
VITE_API_BASE_URL=

# WebSocket 서버 URL
# 비워두면 같은 origin의 /ws 프록시를 사용합니다.
VITE_WS_BASE_URL=
VITE_GRAFANA_BASE_URL=http://localhost:3001

# 프론트와 백엔드를 완전히 다른 도메인으로 배포할 때만 예시처럼 설정합니다.
# VITE_API_BASE_URL=https://api.example.com
# VITE_WS_BASE_URL=wss://api.example.com
